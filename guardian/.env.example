# Acting model (OpenAI or an OpenAI-compatible endpoint). The agent reads
# MODEL_GATEWAY_BASE_URL; use https://api.openai.com/v1 to call OpenAI directly.
OPENAI_API_KEY=
MODEL_GATEWAY_BASE_URL=http://127.0.0.1:4000/v1
MODEL_NAME=gpt-4o-mini

# Local Granite Guardian. Set false to skip its semantic assessment.
ENABLE_GUARDIAN=true
GUARDIAN_BASE_URL=http://127.0.0.1:11434/v1/
GUARDIAN_MODEL=guardian-local
# GUARDIAN_API_KEY=
