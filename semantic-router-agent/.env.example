# Key accepted by the model gateway configured in router.yaml.
OPENAI_API_KEY=
# Routing-only API; no generation requests or gateway credentials go here.
SEMANTIC_ROUTER_API_URL=http://127.0.0.1:8080
# OpenAI-compatible model gateway, reachable directly from the Python agent.
MODEL_GATEWAY_BASE_URL=http://127.0.0.1:4000/v1

# Reuse the existing sample database; paths are relative to this folder.
CHINOOK_DB_PATH=../../langchain-basics/chinook.db

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=semantic-router-music-store
